upstream seaweedfs_s3_backends {
    keepalive 32;

    {% for backend in nginx_s3_backends %}
    server {{ backend }};
    {% endfor %}
}

server {
    listen 80;

    server_name {{ nginx_s3_domain }};

    # Отключаем лимит на размер загружаемого файла.
    client_max_body_size 0;

    # Отключаем буферизацию. Данные будут стримиться напрямую в SeaweedFS.
    proxy_request_buffering off;

    # S3 использует специфические заголовки, разрешаем их.
    ignore_invalid_headers off;

    location / {
        proxy_pass http://seaweedfs_s3_backends;

        # Настройки для поддержки keepalive в сторону бэкендов
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Проброс заголовков для корректной маршрутизации и аутентификации
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Увеличенные таймауты для загрузки тяжелых объектов (multipart upload)
        proxy_connect_timeout 300;
        proxy_send_timeout 300;
        proxy_read_timeout 300;
        send_timeout 300;
    }
}